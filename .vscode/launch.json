        {
            "name": "Debug unit tests in executable 'e2e-tests'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=e2e-tests",
                    "--package=e2e-tests"
                ]
            }
        },
       
                {
                    "name": "Debug RISC-V EVM counter",
                    "type": "lldb",
                    "request": "launch",
                    "cargo": {
                        "args": [
                            "build",
                            "--package",
                            "counter_riscvim32_smart_contract_asm"
                        ],
                        "filter": {
                            "name": "counter_riscvim32_smart_contract_asm",
                            "kind": "bin"
                        }
                    },
                    "args": [],
                    "cwd": "${workspaceFolder}",
                    "sourceLanguages": [
                        "rust"
                    ],
                    "stopOnEntry": false
                },
        {
                    "name": "Debug RISC-V EVM counter interaction",
                    "type": "lldb",
                    "request": "launch",
                    "cargo": {
                        "args": [
                            "run",
                            "-p",
                            "counter_riscvim32_smart_contract_asm",
                            "--example",
                            "interact"
                        ],
                        "filter": {
                            "name": "counter_riscvim32_smart_contract_asm",
                            "kind": "bin"
                        }
                    },
                    "args": [],
                    "cwd": "${workspaceFolder}",
                    "sourceLanguages": [
                        "rust"
                    ],
                    "stopOnEntry": false
                }
        
