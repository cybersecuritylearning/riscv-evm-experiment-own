        {
            "name": "Debug executable 'e2e-tests'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=e2e-tests",
                    "--package=e2e-tests"
                ]
            },
            "args": []
